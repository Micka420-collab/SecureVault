# ==========================================
# SecureVault Platform - Environment Config
# By Nextendo - https://github.com/nextendo/securevault
# ==========================================
# 
# ⚠️  IMPORTANT: Ce fichier contient des variables sensibles.
# Ne partagez jamais ce fichier et gardez-le secret!
#
# 🔐 Générez des secrets forts avec:
#    openssl rand -base64 64
#
# ==========================================

# ==========================================
# Database Configuration
# ==========================================
# En production, utilisez PostgreSQL, pas SQLite!
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://vault:votre_mot_de_passe_db_secure@localhost:5432/securevault

# Variables legacy (pour compatibilité)
DB_USER=vault
DB_PASSWORD=VOTRE_MOT_DE_PASSE_DB_COMPLEXE_MIN_20_CARACTERES
DB_NAME=securevault

# ==========================================
# Security Keys (MUST be changed!)
# 🔐 Générez avec: openssl rand -base64 64
# Minimum 64 caractères recommandé
# ==========================================
JWT_SECRET=GENEREZ_UN_SECRET_DE_64_CARACTERES_MINIMUM_AVEC_OPENSSL_RAND_BASE64_64
SESSION_SECRET=GENEREZ_UN_SECRET_DE_64_CARACTERES_MINIMUM_AVEC_OPENSSL_RAND_BASE64_64
REAL_EMAIL_ENCRYPTION_KEY=GENEREZ_UNE_CLE_DE_32_CARACTERES_AVEC_OPENSSL_RAND_BASE64_32

# ==========================================
# Email Configuration
# ==========================================
MAIL_DOMAIN=votre-domaine.com
SMTP_HOST=smtp.votre-domaine.com
SMTP_PORT=587
SMTP_USER=noreply@votre-domaine.com
SMTP_PASS=votre_mot_de_passe_smtp

# ==========================================
# Frontend Configuration
# ==========================================
VITE_API_URL=http://localhost:3001
FRONTEND_PORT=8080
FRONTEND_SSL_PORT=8443

# ==========================================
# CORS Configuration
# ==========================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:80

# ==========================================
# Rate Limiting Configuration
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# Secure Documents Configuration
# ==========================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=524288000

# ==========================================
# Monitoring (Optional)
# ==========================================
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# ==========================================
# Security Headers & Features
# ==========================================
NODE_ENV=production
SECURE_COOKIES=true
TRUST_PROXY=false

# ==========================================
# Notes de Sécurité
# ==========================================
# 1. Ne JAMAIS commiter ce fichier avec des vraies valeurs
# 2. Utilisez toujours des secrets de 64+ caractères
# 3. En production, utilisez PostgreSQL, pas SQLite
# 4. Activez HTTPS avec des certificats valides
# 5. Configurez Fail2ban pour la protection brute-force
# 6. Sauvegardez régulièrement vos données
# 7. Testez votre plan de récupération
# ==========================================
